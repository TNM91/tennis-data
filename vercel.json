{
  "ignoreCommand": "node scripts/vercel-ignore-native-only.mjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true,
      "staging": true
    }
  },
  "crons": [
    {
      "path": "/api/team-rooms/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/league-weekly-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/account-erasure",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/native-hit-reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}
